# Required
DATABASE_URL="postgresql://claude_agent:claude_agent@localhost:5432/claude_agent"
# In Docker: postgresql://claude_agent:claude_agent@postgres:5432/claude_agent
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000
# Legacy single-repo fallback (used if no repos configured in admin)
# REPO_PATH=/path/to/your/codebase
TOKEN_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32
KNOWLEDGE_API_SECRET=change-me-to-a-random-string

# Optional
UPLOAD_PATH=./uploads
MAX_CONCURRENT_SESSIONS=5
SESSION_IDLE_TIMEOUT_MS=300000
CLAUDE_MAX_TURNS=25

# Test mode — set to "true" to skip Google OAuth and use a simple login form
# AUTH_TEST_MODE=true
# NEXT_PUBLIC_AUTH_TEST_MODE=true

# GitLab integration (multi-repo)
# GITLAB_TOKEN=glpat-your-gitlab-personal-access-token
# REPOS_DIR=/data/repos

OPENROUTER_API_KEY=your-openrouter-api-key

# Email notifications (Resend)
# RESEND_API_KEY=re_your_api_key
# FROM_EMAIL=noreply@yourdomain.com
# REPLY_TO_EMAIL=support@yourdomain.com

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
