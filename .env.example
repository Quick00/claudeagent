# Required
DATABASE_URL="file:./dev.db"
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000
REPO_PATH=/path/to/your/codebase
TOKEN_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32
KNOWLEDGE_API_SECRET=change-me-to-a-random-string

# Optional
MAX_CONCURRENT_SESSIONS=5
SESSION_IDLE_TIMEOUT_MS=300000
CLAUDE_MAX_TURNS=25

# Test mode — set to "true" to skip Google OAuth and use a simple login form
# AUTH_TEST_MODE=true
# NEXT_PUBLIC_AUTH_TEST_MODE=true

# GitLab webhook
# GITLAB_WEBHOOK_SECRET=your-gitlab-webhook-secret
